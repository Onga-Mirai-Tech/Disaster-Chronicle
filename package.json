{
  "name": "disaster-chronicle",
  "private": true,
  "description": "Disaster Chronicle（日本の災害アーカイブ検索・非公式）",
  "scripts": {
    "build:assets": "bash scripts/build-assets.sh",
    "dev:css": "tailwindcss -i src/tailwind.css -o assets/app.css --watch",
    "test": "TZ=Asia/Tokyo node --test 'tests/*.test.js' && TZ=America/Los_Angeles node --test 'tests/*.test.js'"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
